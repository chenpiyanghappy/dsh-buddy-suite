{
  "name": "dsh-buddy-suite",
  "displayName": "DSH Buddy Suite",
  "description": "把 WorkBuddy 国内版账号的「模型接入」与「每日签到」合成一个插件：自动签到所有本机账号，同时把 WorkBuddy 模型接进 DeepSeek Harness — WorkBuddy CN models plus automatic daily check-in in one plugin.",
  "version": "0.1.0",
  "author": "chenpiyang",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "deepseek",
    "workbuddy",
    "model-provider",
    "check-in"
  ],
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.client.json",
    "verify": "node scripts/verify-bundle.mjs && node scripts/verify-client.mjs",
    "check": "pnpm run typecheck && pnpm run test && pnpm run build && pnpm run verify",
    "check:offline": "pnpm run typecheck && node run-vitest.mjs && pnpm run build && pnpm run verify"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-model-selection",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  },
  "dependencies": {
    "@earendil-works/pi-ai": "1.3.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/dsh-attachment": "0.2.1-rc.2",
    "@deepseek-ai/dsh-home-paths": "0.2.1-rc.2",
    "@deepseek-ai/dsh-host-webserver": "0.2.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.2",
    "@deepseek-ai/dsh-llm-pi-ai": "0.2.1-rc.2",
    "@deepseek-ai/dsh-settings": "0.2.1-rc.2",
    "@deepseek-ai/schemastery": "^3.18.5",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/dsh-atomic-write": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-locale": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-conversation": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-model-selection": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-plugin-manager": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-settings-plugins": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.1-rc.2",
    "@deepseek-ai/dsh-credentials": "0.2.1-rc.2",
    "@deepseek-ai/dsh-authorization": "0.2.1-rc.2",
    "@deepseek-ai/dsh-fs": "0.2.1-rc.2",
    "@deepseek-ai/dsh-launch-environment": "0.2.1-rc.2",
    "@deepseek-ai/dsh-home-paths": "0.2.1-rc.2",
    "@deepseek-ai/dsh-host-webserver": "0.2.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.2",
    "@deepseek-ai/dsh-llm-pi-ai": "0.2.1-rc.2",
    "@deepseek-ai/dsh-settings": "0.2.1-rc.2",
    "@deepseek-ai/schemastery": "^3.18.5",
    "@earendil-works/pi-ai": "1.3.0",
    "@types/node": "^22.20.0",
    "@types/react": "~18.3.1",
    "@types/react-test-renderer": "^18.3.1",
    "react": "^18.2.0",
    "react-test-renderer": "18.3.1",
    "tsdown": "^0.22.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.8"
  }
}
